{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["width", "height", "structures"],
  "properties": {
    "width": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "地图宽度（列数）"
    },
    "height": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "description": "地图高度（行数）"
    },
    "structures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/definitions/Corridor" },
          { "$ref": "#/definitions/Stair2x2" },
          { "$ref": "#/definitions/Stair3x3T" },
          { "$ref": "#/definitions/Stair3x3O" },
          { "$ref": "#/definitions/YCorridor" },
          { "$ref": "#/definitions/CenterCorridor" },
          { "$ref": "#/definitions/MainEntrance" },
          { "$ref": "#/definitions/MuseRoom" },
          { "$ref": "#/definitions/BedRoom" },
          { "$ref": "#/definitions/FiveBedRoom" },
          { "$ref": "#/definitions/MeetingRoom" },
          { "$ref": "#/definitions/RestaurantRoom" },
          { "$ref": "#/definitions/CornerRoomA" },
          { "$ref": "#/definitions/CornerRoomB" },
          { "$ref": "#/definitions/CenterRoom" },
          { "$ref": "#/definitions/SafeRoom" },
          { "$ref": "#/definitions/StairRoom" },
          { "$ref": "#/definitions/TRoom" },
          { "$ref": "#/definitions/LanternRoom" }
        ]
      }
    }
  },
  "definitions": {
    "BaseStructure": {
      "type": "object",
      "properties": {
        "originX": {
          "type": "integer",
          "default": 0,
          "description": "结构原点X坐标（列）"
        },
        "originY": {
          "type": "integer",
          "default": 0,
          "description": "结构原点Y坐标（行）"
        },
        "rotation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0,
          "description": "顺时针旋转次数（0-3）"
        }
      }
    },
    "SingleLayer": {
      "properties": {
        "layer": {
          "type": "string",
          "enum": ["upper", "lower"],
          "description": "结构所在层（非双层结构必需）"
        }
      },
      "required": ["layer"]
    },
    "Door": {
      "type": "object",
      "required": ["row", "col", "facing"],
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "col": { "type": "integer", "minimum": 0 },
        "facing": {
          "type": "string",
          "enum": ["north", "south", "east", "west"]
        }
      }
    },
    "Cell": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 0 },
      "description": "单元格坐标 [row, col]"
    },
    "Corridor": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "corridor" },
            "cells": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/Cell" }
            },
            "doors": {
              "type": "array",
              "items": { "$ref": "#/definitions/Door" }
            }
          },
          "required": ["type", "cells", "doors"]
        }
      ]
    },
    "Stair2x2": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        {
          "properties": {
            "type": { "const": "stair_2x2" }
          },
          "required": ["type"]
        }
      ]
    },
    "Stair3x3T": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        {
          "properties": {
            "type": { "const": "stair_3x3_t" }
          },
          "required": ["type"]
        }
      ]
    },
    "Stair3x3O": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        {
          "properties": {
            "type": { "const": "stair_3x3_o" }
          },
          "required": ["type"]
        }
      ]
    },
    "YCorridor": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "y_corridor" }
          },
          "required": ["type"]
        }
      ]
    },
    "CenterCorridor": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "center_corridor" }
          },
          "required": ["type"]
        }
      ]
    },
    "MainEntrance": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "main_entrance" }
          },
          "required": ["type"]
        }
      ]
    },
    "MuseRoom": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "muse_room" }
          },
          "required": ["type"]
        }
      ]
    },
    "BedRoom": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "bed_room" }
          },
          "required": ["type"]
        }
      ]
    },
    "FiveBedRoom": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "five_bed_room" }
          },
          "required": ["type"]
        }
      ]
    },
    "MeetingRoom": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "meeting_room" }
          },
          "required": ["type"]
        }
      ]
    },
    "RestaurantRoom": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        {
          "properties": {
            "type": { "const": "restaurant_room" }
          },
          "required": ["type"]
        }
      ]
    },
    "CornerRoomA": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "corner_room_a" }
          },
          "required": ["type"]
        }
      ]
    },
    "CornerRoomB": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "corner_room_b" }
          },
          "required": ["type"]
        }
      ]
    },
    "CenterRoom": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "center_room" }
          },
          "required": ["type"]
        }
      ]
    },
    "SafeRoom": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "safe_room" }
          },
          "required": ["type"]
        }
      ]
    },
    "StairRoom": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "stair_room" }
          },
          "required": ["type"]
        }
      ]
    },
    "TRoom": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "t_room" }
          },
          "required": ["type"]
        }
      ]
    },
    "LanternRoom": {
      "allOf": [
        { "$ref": "#/definitions/BaseStructure" },
        { "$ref": "#/definitions/SingleLayer" },
        {
          "properties": {
            "type": { "const": "lantern_room" }
          },
          "required": ["type"]
        }
      ]
    }
  }
}